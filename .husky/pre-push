#!/bin/sh
# Husky pre-push hook - Al-Zahra Smart ERP
#
# Single source of truth for the gate list: the "pre-push" script in
# alzhraERP/package.json. This file used to keep its own duplicate list, and the
# two drifted apart (the hook ran the build but not layers/type-check:tests;
# the npm script had the opposite gap). Add any new gate in ONE place only.
#
# The full lint-debt gate (lint-total, an ~8 minute scan of every file) stays in
# CI on every push to main; the hook runs the changed-files ratchet only.
#
# Comments kept ASCII-only: this file once contained mojibake.

echo "[pre-push] Running the unified gate list (alzhraERP/package.json -> scripts.pre-push)..."

cd alzhraERP || exit 1

npm run pre-push || exit 1

echo "[pre-push] All gates passed. Pushing."
