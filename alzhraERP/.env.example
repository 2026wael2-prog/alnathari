# Al-Zahra Smart ERP - Environment Variables
# Copy this file to .env and fill in the values

# --- Supabase Configuration ---
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
VITE_SUPABASE_URL=https://orxlyiokccaodypindye.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --- AI Configuration ---
# ⚠️ NEVER add AI keys with a VITE_ prefix — they get bundled into the browser
# and are exposed to anyone visiting the site. AI keys live ONLY server-side
# in Supabase Edge Functions (see supabase/functions/ai-proxy):
#   OPENROUTER_API_KEY / DEEPSEEK_API_KEY

# --- Feature Flags ---
VITE_ENABLE_AI_FEATURES=true
VITE_DEV_MODE=true

# --- Web Push (تنبيهات التحصيل مع إغلاق المتصفح) ---
# المفتاح العام فقط. المفتاح الخاص يبقى سراً على الخادم:
#   supabase secrets set VAPID_PUBLIC_KEY=... VAPID_PRIVATE_KEY=... VAPID_SUBJECT=mailto:...
# توليد الزوج: npx web-push generate-vapid-keys
# بدون هذه القيمة يظهر خيار التنبيهات كـ«غير مهيّأة» بدل أن يفشل بصمت.
# VITE_VAPID_PUBLIC_KEY=

# Google OAuth sign-in — the provider IS enabled in the Supabase project and
# real users sign in with it, so the login button shows BY DEFAULT. Only set this
# to false to temporarily hide the button (e.g. provider maintenance).
# VITE_ENABLE_GOOGLE_LOGIN=false

# --- Optional: Sentry for Error Tracking ---
# VITE_SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz
